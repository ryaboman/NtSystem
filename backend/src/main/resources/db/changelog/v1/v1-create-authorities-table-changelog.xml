<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="1743359239122-1" author="Aleksey">
        <preConditions>
            <not>
                <tableExists tableName="authorities"/>
            </not>
        </preConditions>
        <createTable tableName="authorities">
            <column name="username" type="varchar(15)">
                <constraints nullable="false" foreignKeyName="fk_username" references="users(username)"/>
            </column>
            <column name="authority" type="varchar(25)"/>
        </createTable>
    </changeSet>


</databaseChangeLog>