<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="1745376154350-1" author="Aleksey">
        <preConditions>
            <not>
                <tableExists tableName="documents_devices"/>
            </not>
        </preConditions>
        <createTable tableName="documents_devices">
            <column name="id_document" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_document" references="documents(id)"/>
            </column>
            <column name="id_device" type="bigint">
                <constraints nullable="false" foreignKeyName="fk_device" references="devices(id)"/>
            </column>
        </createTable>
    </changeSet>


</databaseChangeLog>